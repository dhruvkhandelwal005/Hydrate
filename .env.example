# RAGNAROK Environment Configuration

# Server
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=*

# Primary LLM Provider: Anthropic Claude (Dual-Key Fallback)
ANTHROPIC_API_KEY=your_primary_anthropic_api_key_here
ANTHROPIC_API_KEY1=your_secondary_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# Secondary Fallback Providers (automatic failover)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Firebase / Firestore
FIREBASE_SERVICE_ACCOUNT_PATH=Secrets/hydrate-64582-firebase-adminsdk-fbsvc-cb5e933e14.json
FIREBASE_PROJECT_ID=hydrate-64582
FIREBASE_STORAGE_BUCKET=hydrate-64582.firebasestorage.app

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Trial Limits
MAX_RUNS=3
MAX_SEARCHES_PER_AGENT=8
MAX_RETRIEVED_CHUNKS=8
MAX_CLAIMS_PER_RUN=4
